# SOMENTE DESENVOLVIMENTO. Copie para .env (cp .env.example .env).
# Em produção, os valores reais ficam nas variáveis de ambiente da Netlify
# e nos segredos do GitHub Actions, nunca no repositório.

# Superusuário do Postgres local (só administração local e runner de testes)
POSTGRES_PASSWORD=postgres-dev

# Dono do schema; usado só pelas migrações
NUBANKO_OWNER_PASSWORD=owner-dev

# Papel das functions: sem BYPASSRLS e sem ser dono das tabelas (R-00.1)
NUBANKO_APP_PASSWORD=app-dev

# Papel do Better Auth (/api/auth/*): único com acesso ao schema auth
NUBANKO_AUTH_PASSWORD=auth-dev

# Segredo de assinatura das sessões do Better Auth (gere outro em produção: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-somente-local-troque-em-producao-0123456789

# Chave mestra (32 bytes em base64) que cifra os textos das pessoas no banco: nomes de
# caixinhas, descrições de lançamentos e o nome do perfil. Gere com: openssl rand -base64 32
# Perder esta chave = perder esses textos. Trocar exige recifrar (ver DESENVOLVIMENTO.md, 13.8).
NUBANKO_CHAVE_DADOS=ZGV2LXNvbWVudGUtbG9jYWwtMzItYnl0ZXMtISEhISE=

# Portas publicadas no host (mude se já estiverem em uso)
DB_PORTA=54322
APP_PORTA=8888
MAIL_PORTA=8025

# Usuário com que o app roda no container: use o seu (id -u / id -g), para que os
# arquivos que ele grava no repositório (.netlify/, web/dist/) fiquem com você
APP_UID=1000
APP_GID=1000
