# SOMENTE DESENVOLVIMENTO. Copie para .env (cp .env.example .env).
# Em produção, os valores reais ficam nas variáveis de ambiente da Netlify
# e nos segredos do GitHub Actions, nunca no repositório.

# Superusuário do Postgres local (só administração local e runner de testes)
POSTGRES_PASSWORD=postgres-dev

# Dono do schema; usado só pelas migrações
NUBANKO_OWNER_PASSWORD=owner-dev

# Papel das functions: sem BYPASSRLS e sem ser dono das tabelas (R-00.1)
NUBANKO_APP_PASSWORD=app-dev

# Portas publicadas no host (mude se já estiverem em uso)
DB_PORTA=54322
APP_PORTA=8888
MAIL_PORTA=8025
